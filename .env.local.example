# ============================================
# OPTIMAL BREAKS — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# SECURITY:
# - The anon key is safe to expose client-side (it's rate-limited by RLS)
# - NEVER put service_role key in NEXT_PUBLIC_ variables
# - Enable RLS on all tables in Supabase dashboard
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# JWT legacy (anon) o nuevo formato sb_publishable_* (uno u otro):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor: JWT service_role o nuevo sb_secret_* (no NEXT_PUBLIC_*).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_...

# Postgres (scripts: npm run db:seed / db:migrate)
# Se leen .env y .env.local (este último gana si la misma clave está en ambos).
# A) URI: Supabase → Project Settings → Database → Connection string → URI
# B) O solo contraseña de BD + NEXT_PUBLIC_SUPABASE_URL → SUPABASE_DB_PASSWORD=...
# Alias URI: DATABASE_URL, DIRECT_URL, SUPABASE_DB_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING,
#   SUPABASE_POSTGRES_URL, POSTGRES_PRISMA_URL, SUPABASE_DATABASE_URL
# Alias contraseña: POSTGRES_PASSWORD, PGPASSWORD, DATABASE_PASSWORD
# La service_role (arriba) NO sustituye la contraseña de Postgres para ejecutar .sql con pg.
# DATABASE_SSL=0 desactiva SSL (no recomendado en Supabase).

# --------------------------------------------
# Artistas / sellos / agentes / fotos (UPSERT): solo API Supabase
# --------------------------------------------
# Requiere NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY o SUPABASE_SECRET_KEY.
# actualizar-artista, generar-*-agente, label-upsert, elegir-foto NO usan Postgres (pg).
# Migración previa recomendada para artistas: supabase/migrations/006_artist_extended_fields.sql

# --- Google Analytics 4 (público; opcional) ---
# Tras “Aceptar” cookies analíticas se carga gtag. Vercel: añade la misma variable al proyecto.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VXDS1X91XW

# --- Opcional: OpenAI / agentes editoriales (solo servidor) ---
# Guías: docs/ARTIST_AI_AGENT.md · docs/AI_PROMPTS_AND_AGENTS.md · docs/ADMIN_CHAT_CAPTURA.md (agente chat admin)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5.6-terra  # opcional; default editorial (bios, blog, eventos, chat). Override por flujo: OPENAI_BLOG_MODEL, OPENAI_CHAT_MODEL, OPENAI_VISION_MODEL, OPENAI_SEARCH_MODEL
# OPENAI_CHAT_MODEL=gpt-5.6-terra   # opcional; loop de tools del chat admin (admin-chat-agent.ts). Alias: OPENAI_AGENT_MODEL
# OPENAI_VISION_MODEL=gpt-5.6-terra # opcional; OCR capturas / carteles (chat admin)
# OG_IMAGE_MODEL=gpt-image-2 # opcional; por defecto los generadores de imagen usan gpt-image-2
# SERPAPI_API_KEY=...        # Google vía serpapi.com; si falla o falta, el agente sigue sin web
# DATABASE_URL=postgresql://...  # opcional; tools SQL del chat admin (db_sql_read / stage_db_sql_write)
#
# Chat admin (PWA): /[lang]/administrator/chat — tools + Confirmar antes de escribir. Migración: 062_admin_chat_threads.sql
# Eventos: npm run db:events:enrich -- <slug> (SerpAPI web + OpenAI completa ficha)
#   y npm run db:events:poster -- <slug> (visión/OCR del cartel → Storage)
# Requieren OPENAI_API_KEY + SERPAPI_API_KEY + URL + SERVICE_ROLE
#
# Mixes / YouTube (opcional): fecha de publicación en tabla mixes → orden en /mixes
# Migración: supabase/migrations/021_mixes_published_at.sql (Postgres o SQL Editor Supabase)
# npm run db:mixes:published   o   node scripts/guia-base-datos.mjs run mixes-published [--force]
# YOUTUBE_DATA_API_KEY=...    # YouTube Data API v3 (videos.list). Sin clave: yt-dlp en PATH o scraping HTML.

# --- Spotify Web API (opcional; enlaces «Abrir en Spotify» en /charts) ---
# App en https://developer.spotify.com/dashboard (Web API). Desde feb-2026 el
# Development Mode exige cuenta Premium del dueño; solo usamos client credentials
# (búsqueda servidor→servidor, sin usuarios OAuth), suficiente para el matching.
# npm run db:chart:spotify   (scripts/spotify-match-charts.mjs → columna spotify_url)
# Migración: supabase/migrations/066_charts_spotify_url.sql
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...

# --- TIDAL API (opcional; enlaces «Abrir en TIDAL» en /charts) ---
# App en https://developer.tidal.com/dashboard. Mismo matching que Spotify:
# npm run db:chart:tidal   (spotify-match-charts.mjs --service=tidal → columna tidal_url)
# El botón TIDAL solo aparece con enlace verificado (sin fallback de búsqueda).
# Migración: supabase/migrations/067_charts_tidal_url.sql
# TIDAL_CLIENT_ID=...
# TIDAL_CLIENT_SECRET=...

# --- TinyMCE Cloud (opcional; editor HTML en admin del blog) ---
# NEXT_PUBLIC_TINYMCE_API_KEY=tu-api-key-de-tiny-cloud
