# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
build/
dist/

# Environment (NEVER commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Artistas: canónico en Supabase; JSON locales (agente, export, db:artist)
data/artists/*.json
data/events/discovered*.json

# Notas temporales del agente (chart → enrich)
tmp-chart-agent-notes/

# Catálogos de saves huérfanos (PII de usuarios — no versionar)
data/orphans/

# Debug / logs de agentes (no versionar)
batch-agent-artists.log
photo-artists-images.log
agent-batch-log.txt
agent-starter-bio-run.log
tidal-beatport.log
*-beatport.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratchpads del agente y listas semanales sueltas en la raíz
# (logs de scripts puntuales, notas de trabajo, drafts no canónicos)
tmp-*.log
tmp-*.txt
tmp-*.json
tmp-*.png
_tmp-*
scripts/_tmp-*
# Progreso de lotes de archivo (se reescribe al correr el script; no es código)
scripts/_archive-*-progress.txt

# Carteles originales de Karmic Waves (fuentes locales de push-karmic-waves-events).
# El zip y los JPG/PNG no los sirve la web; lo publicado va a Storage.
karmic_waves_events/

# Carruseles / exports de Instagram (no los sirve la web)
instagram_images/

# Capturas de cámara soltadas en promo (la promo canónica es charts-promo*.webp)
public/images/promo/Foto *

# Correos de artistas (PII). El resto de artists_docs sí se versiona (notas, EPK).
artists_docs/**/email*

# Másteres que cede el artista (WAV, FLAC, carátula). Se quedan en private/music/
# en el disco. No entran en Git ni en Vercel: son el regalo, no el archivo público.
# Solo el MP3 de streaming se versiona (la lambda de /api/audio lo empaqueta).
private/music/*
!private/music/*.mp3

# Subcarpetas antiguas de originales bajo public/ (no servir ni versionar).
public/music/*/

# Logs de lotes NR / imports de vinilos / bios y colas pendientes (trabajo del agente)
data/charts/**/*.log
data/charts/*.log
data/charts/pending-nr-urls-*.txt
listaseman*.txt
listasemana*.txt

# Briefs / notas de trabajo del agente de blog (no el JSON canónico de artículos)
data/blog/_brief*
data/blog/*.brief.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
# Preferencias locales de Cursor; las reglas (.cursor/rules/) sí van en Git
.cursor/settings.json

# OS
.DS_Store
Thumbs.db

# Supabase CLI (caché local)
supabase/.temp/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# MP3 de sesiones para descarga: se publican en la release «sesiones-descarga» de GitHub, nunca en el repo
music/dowload_mixes/
